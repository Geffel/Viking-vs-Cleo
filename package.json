{
  "name": "viking-vs-cleo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "2D lagbaserad arenafighter for lokalt natverk",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "check:runtime": "node tools/check-runtime.mjs",
    "prestart": "npm run check:runtime",
    "start": "node server/index.js",
    "test": "node test/run-all.mjs",
    "test:net": "node test/netcode.mjs && node test/server-protocol.mjs",
    "test:hits": "node test/hitreg.mjs",
    "test:combat": "node test/combat.mjs",
    "test:abilities": "node test/abilities.mjs",
    "test:layout": "node test/ability-layout.mjs",
    "test:powerup": "node test/powerup.mjs",
    "test:platforms": "node test/platforms.mjs",
    "measure:ticks": "node tools/measure-tick-baseline.mjs",
    "profiles:import": "node tools/import-profiles.mjs import",
    "profiles:verify": "node tools/import-profiles.mjs verify",
    "profiles:backup": "node tools/import-profiles.mjs backup",
    "profiles:restore": "node tools/import-profiles.mjs restore",
    "peek": "node test/peek.mjs",
    "sprites": "node tools/prepare-sprites.mjs",
    "sprites:run": "node tools/prepare-run-sprites.mjs cleo && node tools/prepare-run-sprites.mjs viking",
    "sprites:cleo-run": "node tools/prepare-run-sprites.mjs cleo",
    "sprites:viking-run": "node tools/prepare-run-sprites.mjs viking",
    "sprites:shield": "node tools/prepare-viking-shield.mjs",
    "powerups": "node tools/prepare-powerups.mjs",
    "thumbs": "node tools/prepare-map-thumbs.mjs",
    "ice-spikes": "node tools/prepare-ice-spikes.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
